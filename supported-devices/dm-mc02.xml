<board>
    <!-- UART5 RX (PD2) is the DBUS input, inverted in hardware on the board -->
    <can-pins>
        <gpio alias="Can1Rx" name="GpioD0"></gpio>
        <gpio alias="Can1Tx" name="GpioD1"></gpio>
        <gpio alias="Can2Rx" name="GpioB5"></gpio>
        <gpio alias="Can2Tx" name="GpioB6"></gpio>
    </can-pins>
    <gpio-pins>
        <gpio alias="PA00" name="GpioA0">
            <!-- PWM header P11 pins 1-4, on the switchable 5V rail (PC15) -->
            <timer name="Timer2" channel="Ch1"></timer>
        </gpio>
        <gpio alias="PA02" name="GpioA2">
            <timer name="Timer2" channel="Ch3"></timer>
        </gpio>
        <gpio alias="PE09" name="GpioE9">
            <timer name="Timer1" channel="Ch1"></timer>
        </gpio>
        <gpio alias="PE13" name="GpioE13">
            <timer name="Timer1" channel="Ch3"></timer>
        </gpio>
        <gpio alias="Buzzer" name="GpioB15">
            <timer name="Timer12" channel="Ch2"></timer>
        </gpio>
        <gpio alias="ImuHeater" name="GpioB1">
            <timer name="Timer3" channel="Ch4"></timer>
        </gpio>
        <gpio alias="Button" name="GpioA15"></gpio>
        <gpio alias="PE14" name="GpioE14">
            <!-- Expansion header pin 13 -->
        </gpio>
        <gpio alias="Laser" name="GpioE14">
            <!-- Not a laser port, the board has none. Same pin as PE14. Only here so the
                 CI template (ci-project-template.xml, digital_out_pins = Laser) builds -->
        </gpio>
        <gpio alias="PD10" name="GpioD10">
            <!-- LCD header pin 8 -->
        </gpio>
    </gpio-pins>
    <uart-ports>
        <uart sync="true" name="1" tx="GpioA9" rx="GpioA10"></uart>
        <uart sync="false" name="5" rx="GpioD2"></uart>
        <uart sync="false" name="7" tx="GpioE8" rx="GpioE7"></uart>
        <uart sync="true" name="10" tx="GpioE3" rx="GpioE2"></uart>
    </uart-ports>
</board>
