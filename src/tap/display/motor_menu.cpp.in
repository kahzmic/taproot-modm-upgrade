#include "motor_menu.hpp"

#include <algorithm>
#include <cmath>

#include "tap/drivers.hpp"
#include "tap/motor/dji_motor.hpp"
#include "tap/motor/dji_motor_tx_handler.hpp"

using namespace tap::motor;
using namespace tap::can;

namespace tap
{
namespace display
{
MotorMenu::MotorMenu(
    modm::ViewStack<DummyAllocator<modm::IAbstractView> >* stack,
    Drivers* drivers,
    int entriesToDisplay)
    : modm::AbstractMenu<DummyAllocator<modm::IAbstractView> >(stack, MOTOR_MENU_ID),
      drivers(drivers),
      verticalScroll(drivers, DjiMotorTxHandler::DJI_MOTORS_PER_CAN * {{ can_buses|length }}, entriesToDisplay),
      motorSpecificMenu(getViewStack(), drivers, nullptr)
{
}

void MotorMenu::drawMotor(CanBus canBus, int normalizedMotorId)
{
    const DjiMotor* motor = nullptr;
    const char* canBusName = "CAN?";
    bool printCursor = false;
    switch (canBus)
    {
        case CanBus::CAN_BUS1:
            motor = drivers->djiMotorTxHandler.getCan1Motor(
                NORMALIZED_ID_TO_DJI_MOTOR(normalizedMotorId));
            canBusName = "CAN1";
            printCursor = (normalizedMotorId == verticalScroll.getCursorIndex());
            break;
%% for bus in can_buses[1:]
        case CanBus::CAN_BUS{{ bus }}:
            motor = drivers->djiMotorTxHandler.getCan{{ bus }}Motor(
                NORMALIZED_ID_TO_DJI_MOTOR(normalizedMotorId));
            canBusName = "CAN{{ bus }}";
            printCursor =
                ((normalizedMotorId + {{ (bus - 1) ~ " * " if bus > 2 }}DjiMotorTxHandler::DJI_MOTORS_PER_CAN) ==
                 verticalScroll.getCursorIndex());
            break;
%% endfor
    }

    getViewStack()->getDisplay() << (printCursor ? ">" : " ") << canBusName << " Motor "
                                 << (normalizedMotorId + 1);

    if (motor != nullptr)
    {
        if (motor->isMotorOnline())
        {
            getViewStack()->getDisplay() << ": ON";
        }
        else
        {
            getViewStack()->getDisplay() << ": OFF";
        }
    }
    else
    {
        getViewStack()->getDisplay() << ": NULL";
    }
    getViewStack()->getDisplay() << modm::endl;
}

void MotorMenu::draw()
{
    modm::GraphicDisplay& display = getViewStack()->getDisplay();
    display.clear();
    display.setCursor(0, 2);
    display << getMenuName() << modm::endl;

    auto can1MinIndex = verticalScroll.getSmallestIndexDisplayed();
    auto can1MaxIndex = std::min(
        DjiMotorTxHandler::DJI_MOTORS_PER_CAN - 1,
        static_cast<int>(verticalScroll.getLargestIndexDisplayed()));
    for (int8_t motorId = can1MinIndex; motorId <= can1MaxIndex; ++motorId)
    {
        drawMotor(CanBus::CAN_BUS1, motorId);
    }

%% for bus in can_buses[1:]
{{ "\n" if not loop.first }}    auto can{{ bus }}MinIndex = std::max(
        0,
        verticalScroll.getSmallestIndexDisplayed() - {{ (bus - 1) ~ " * " if bus > 2 }}DjiMotorTxHandler::DJI_MOTORS_PER_CAN);
    auto can{{ bus }}MaxIndex = std::min(
        DjiMotorTxHandler::DJI_MOTORS_PER_CAN - 1,
        verticalScroll.getLargestIndexDisplayed() - {{ (bus - 1) ~ " * " if bus > 2 }}DjiMotorTxHandler::DJI_MOTORS_PER_CAN);
    for (int motorId = can{{ bus }}MinIndex; motorId <= can{{ bus }}MaxIndex; ++motorId)
    {
        drawMotor(CanBus::CAN_BUS{{ bus }}, motorId);
    }
%% endfor
}

void MotorMenu::update() {}

bool MotorMenu::hasChanged()
{
%% for bus in can_buses
    uint8_t newCan{{ bus }}MotorStatus = 0;
%% endfor
    for (uint32_t motorId = MotorId::MOTOR1; motorId <= MotorId::MOTOR8; ++motorId)
    {
        DjiMotor const* currMotor = NULL;
%% for bus in can_buses
{{ "\n" }}        currMotor = drivers->djiMotorTxHandler.getCan{{ bus }}Motor(static_cast<MotorId>(motorId));
        if (currMotor != nullptr && currMotor->isMotorOnline())
        {
            newCan{{ bus }}MotorStatus |= (1 << DJI_MOTOR_TO_NORMALIZED_ID(motorId));
        }
%% endfor
    }

%% for bus in can_buses
%% if loop.first
    bool motorStatusChanged = (can{{ bus }}PrevDisplayedStatus != newCan{{ bus }}MotorStatus) ||
%% else
                              (can{{ bus }}PrevDisplayedStatus != newCan{{ bus }}MotorStatus){{ ";\n" if loop.last else " ||" }}
%% endif
%% endfor
%% for bus in can_buses
    can{{ bus }}PrevDisplayedStatus = newCan{{ bus }}MotorStatus;{{ "\n" if loop.last }}
%% endfor
    return verticalScroll.acknowledgeCursorChanged() || motorStatusChanged;
}

void MotorMenu::shortButtonPress(modm::MenuButtons::Button button)
{
    switch (button)
    {
        case modm::MenuButtons::LEFT:
            this->remove();
            break;
        case modm::MenuButtons::RIGHT:
        {
            int8_t idx = verticalScroll.getCursorIndex();
            if (idx < DjiMotorTxHandler::DJI_MOTORS_PER_CAN)  // idx between [0, 8)
            {
                const DjiMotor* motor =
                    drivers->djiMotorTxHandler.getCan1Motor(NORMALIZED_ID_TO_DJI_MOTOR(idx));
                if (motor != nullptr)
                {
                    this->getViewStack()->push(
                        new (&motorSpecificMenu) MotorSpecificMenu(getViewStack(), drivers, motor));
                }
            }
%% for bus in can_buses[1:]
%% if not loop.last
            else if (idx < {{ bus }} * DjiMotorTxHandler::DJI_MOTORS_PER_CAN)  // idx between [{{ 8 * (bus - 1) }}, {{ 8 * bus }})
%% else
            else  // idx between [{{ 8 * (bus - 1) }}, {{ 8 * bus }})
%% endif
            {
                const DjiMotor* motor = drivers->djiMotorTxHandler.getCan{{ bus }}Motor(
                    NORMALIZED_ID_TO_DJI_MOTOR(idx - {{ (bus - 1) ~ " * " if bus > 2 }}DjiMotorTxHandler::DJI_MOTORS_PER_CAN));
                if (motor != nullptr)
                {
                    this->getViewStack()->push(
                        new (&motorSpecificMenu) MotorSpecificMenu(getViewStack(), drivers, motor));
                }
            }
%% endfor
            break;
        }
        case modm::MenuButtons::DOWN:
            verticalScroll.onShortButtonPress(modm::MenuButtons::DOWN);
            break;
        case modm::MenuButtons::UP:
            verticalScroll.onShortButtonPress(modm::MenuButtons::UP);
            break;
        case modm::MenuButtons::OK:
            break;
    }
}
}  // namespace display
}  // namespace tap

